# Public URL may also be used as SUPABASE_URL on the server.
# On Vercel: Development = development project, Production = production project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never NEXT_PUBLIC_. Used to upsert opportunities.
# Development project on the Development environment; production project on Production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Signs the desk session cookie. Falls back to SUPABASE_SERVICE_ROLE_KEY.
SESSION_SECRET=

# Server only. Never NEXT_PUBLIC_. 32-byte key as 64 hex characters.
# Different value on Vercel Development vs Production. openssl rand -hex 32
EXCHANGE_CREDENTIALS_KEY=

# Optional. Origin used when Futures Settings prints the TradingView webhook URL
# and Stripe Checkout / Portal return URLs.
# Example: https://your-app.vercel.app  (no trailing slash)
APP_BASE_URL=

# Stripe. Test keys on Vercel Development / .env.local. Live keys on Production only.
# Never NEXT_PUBLIC_ for the secret or webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key only (pk_test_ / pk_live_). Required for the on-site embed.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Encrypts the deposit HD seed and the dedicated gas wallet private key.
# Server / billing worker only. Never NEXT_PUBLIC_. Different value on develop vs main.
# openssl rand -hex 32
# Do not put the admin wallet seed or private key in any variable.
BILLING_CREDENTIALS_KEY=

# Optional later. Server only. Never NEXT_PUBLIC_. Public RPCs are used for now
# (Arbitrum Sepolia official endpoint on develop). Add Alchemy when Click switches.
# ALCHEMY_API_KEY=
